# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 git 에 올라가지 않습니다.

# OpenAI API 키 (https://platform.openai.com/api-keys)
# 비워 두면 서버가 MOCK 모드로 동작합니다 (원본 이미지를 그대로 돌려줌).
OPENAI_API_KEY=

# openai | mock  (비워 두면 키 유무로 자동 결정)
IMAGE_PROVIDER=

# 이미지 편집 모델 및 출력 옵션
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
# png 는 용량이 커서 Vercel 응답 한도(4.5MB)를 넘을 수 있어 jpeg 를 기본값으로 둠
OPENAI_OUTPUT_FORMAT=jpeg

# 로컬 서버 포트
PORT=3000

# 프론트를 다른 도메인에서 서빙할 때만 지정 (쉼표로 여러 개). 같은 도메인이면 비워 둠
CORS_ORIGIN=
